---
// The page's sections as a small table of contents: down the right edge on wide screens, across
// the top on narrow ones. The section in view is highlighted as you scroll.
const sections = [
  { id: "tldr", label: "TL;DR" },
  { id: "work", label: "Work" },
];
const item = "rounded-md px-2.5 py-1 text-faint transition-colors hover:text-ink";
---

<nav
  aria-label="Sections"
  class="mx-auto flex max-w-[680px] flex-wrap gap-1 px-2.5 pt-8 text-xs lg:fixed lg:top-1/2 lg:right-6 lg:z-10 lg:-translate-y-1/2 lg:flex-col lg:items-end lg:p-0"
>
  {sections.map((s, i) => (
    <a
      href={`/#${s.id}`}
      data-section={s.id}
      aria-current={i === 0 ? "true" : "false"}
      class={`${item} aria-[current=true]:bg-panel aria-[current=true]:text-ink`}
    >
      {s.label}
    </a>
  ))}
  <a href="/resume.pdf" target="_blank" rel="noreferrer" class={item}>Resume ↗</a>
  <button type="button" id="theme-toggle" class={`${item} cursor-pointer`}>
    <span class="light:hidden">Light mode</span><span class="hidden light:inline">Dark mode</span>
  </button>
</nav>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>("a[data-section]")];
  const sections = links
    .map((a) => document.getElementById(a.dataset.section ?? ""))
    .filter((s): s is HTMLElement => s !== null);

  // The current section is the last one whose top has passed 40% of the window, or the last
  // section once the page is scrolled to the bottom.
  function update() {
    let current = sections[0]?.id;
    for (const s of sections) if (s.getBoundingClientRect().top <= innerHeight * 0.4) current = s.id;
    if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) current = sections.at(-1)?.id;
    for (const a of links) a.setAttribute("aria-current", String(a.dataset.section === current));
  }
  addEventListener("scroll", update, { passive: true });
  update();

  // Light/dark toggle. Dark is the default; a choice is remembered in this browser, and Layout
  // applies it before the page is drawn.
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    const light = root.dataset.theme !== "light";
    if (light) root.dataset.theme = "light";
    else delete root.dataset.theme;
    const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    if (themeColor) themeColor.content = light ? "#fafafa" : "#000000";
    try {
      localStorage.setItem("theme", light ? "light" : "dark");
    } catch {
      // Storage can be blocked (private browsing); the toggle still works for this visit.
    }
  });
</script>
