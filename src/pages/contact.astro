---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---

<Layout title="Contact" description="Get in touch with me.">
  <section class="mx-auto max-w-2xl px-6 py-20">
    <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Get in touch</h1>
    <p class="mt-4 leading-relaxed text-slate-400">
      Whether you have an opportunity, a question, or just want to say hi, my inbox is open.
    </p>

    <div class="mt-10 space-y-4">
      <a
        href={`mailto:${site.email}`}
        class="flex items-center justify-between rounded-xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/40 hover:bg-white/[0.04]"
      >
        <span>
          <span class="block text-sm font-medium text-slate-500">Email</span>
          <span class="text-white">{site.email}</span>
        </span>
        <span class="text-accent">&rarr;</span>
      </a>
      <a
        href={site.github}
        target="_blank"
        rel="noreferrer"
        class="flex items-center justify-between rounded-xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/40 hover:bg-white/[0.04]"
      >
        <span>
          <span class="block text-sm font-medium text-slate-500">GitHub</span>
          <span class="text-white">{site.github.replace("https://", "")}</span>
        </span>
        <span class="text-accent">&rarr;</span>
      </a>
      <a
        href={site.linkedin}
        target="_blank"
        rel="noreferrer"
        class="flex items-center justify-between rounded-xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/40 hover:bg-white/[0.04]"
      >
        <span>
          <span class="block text-sm font-medium text-slate-500">LinkedIn</span>
          <span class="text-white">{site.linkedin.replace("https://", "")}</span>
        </span>
        <span class="text-accent">&rarr;</span>
      </a>
      <a
        href={site.instagram}
        target="_blank"
        rel="noreferrer"
        class="flex items-center justify-between rounded-xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/40 hover:bg-white/[0.04]"
      >
        <span>
          <span class="block text-sm font-medium text-slate-500">Instagram</span>
          <span class="text-white">{site.instagram.replace("https://", "")}</span>
        </span>
        <span class="text-accent">&rarr;</span>
      </a>
    </div>
  </section>
</Layout>
