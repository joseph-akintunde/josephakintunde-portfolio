---
import Layout from "../layouts/Layout.astro";
import { education, experience, leadership } from "../data/experience";
---

<Layout title="Experience" description="Education, internships, and leadership experience.">
  <section class="mx-auto max-w-3xl px-6 py-20">
    <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Experience</h1>
    <p class="mt-4 text-slate-400">Education, internships, and roles I've held.</p>

    <div class="mt-12">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-accent">Education</h2>
      <div class="mt-4 rounded-xl border border-white/10 bg-white/[0.02] p-6">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="text-lg font-semibold text-white">{education.school}</h3>
          <p class="text-sm font-medium text-slate-500">{education.start} – {education.end}</p>
        </div>
        <p class="text-sm text-slate-400">{education.degree} · {education.location}</p>
        <p class="mt-2 text-sm text-slate-400">GPA: {education.gpa} · {education.honors}</p>
      </div>
    </div>

    <div class="mt-14">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-accent">Internships</h2>
      <div class="mt-6 space-y-10 border-l border-white/10 pl-8">
        {experience.map((entry) => (
          <div class="relative">
            <span class="absolute -left-[calc(2rem+5px)] top-1.5 h-2.5 w-2.5 rounded-full bg-accent"></span>
            <p class="text-sm font-medium text-slate-500">{entry.start} – {entry.end}</p>
            <h3 class="mt-1 text-lg font-semibold text-white">{entry.role}</h3>
            <p class="text-sm text-slate-400">{entry.org}{entry.location ? ` · ${entry.location}` : ""}</p>
            <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-slate-400">
              {entry.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-accent">Leadership & Activities</h2>
      <div class="mt-6 space-y-10 border-l border-white/10 pl-8">
        {leadership.map((entry) => (
          <div class="relative">
            <span class="absolute -left-[calc(2rem+5px)] top-1.5 h-2.5 w-2.5 rounded-full bg-accent-2"></span>
            <p class="text-sm font-medium text-slate-500">{entry.start} – {entry.end}</p>
            <h3 class="mt-1 text-lg font-semibold text-white">{entry.role}</h3>
            <p class="text-sm text-slate-400">{entry.org}{entry.location ? ` · ${entry.location}` : ""}</p>
            <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-slate-400">
              {entry.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
