---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { education, experience, incoming, leadership } from "../data/experience";
import { projects } from "../data/projects";

const lower = (s: string) => s.toLowerCase();
const link = "text-ink underline decoration-faint underline-offset-[3px] transition-colors hover:decoration-ink";
const item = "relative pl-6 before:absolute before:left-2 before:text-faint before:content-['•']";
const dates = (start: string, end: string) => ` · ${lower(start)} – ${lower(end)}`;
---

<Layout>
  <section id="tldr" class="mx-auto max-w-[680px] px-5 pt-10 lg:pt-28">
    <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
      <div>
        <h1 class="text-base font-semibold text-ink">{lower(site.name)}</h1>
        <p class="text-muted">{lower(site.tagline)}</p>
      </div>
      <ul class="text-xs text-muted sm:text-right" aria-label="Where I am, and the time there">
        {site.locations.map((l) => (
          <li>
            {lower(l.place)}
            <span class="text-faint" data-time-zone={l.timeZone}></span>
          </li>
        ))}
      </ul>
    </div>

    <p class="mt-8">{site.about}</p>

    <h2 id="experience" class="mt-8">Experience:</h2>
    <ul class="mt-2 space-y-2">
      {incoming.map((r) => <li class={item}>incoming {lower(r.role)} @{lower(r.org)}</li>)}
      {experience.map((r) => (
        <li class={item}>
          {lower(r.role)} @{lower(r.org)}
          <span class="text-faint">{dates(r.start, r.end)}</span>
        </li>
      ))}
    </ul>

    <h2 class="mt-8">Education:</h2>
    <ul class="mt-2">
      <li class={item}>
        {lower(education.degree)} @{lower(education.school)}; {lower(education.honors)}, {education.gpa} gpa
        <span class="text-faint">{dates(education.start, education.end)}</span>
      </li>
    </ul>

    <h2 class="mt-8">Leadership:</h2>
    <ul class="mt-2 space-y-2">
      {leadership.map((r) => (
        <li class={item}>
          {lower(r.role)} @{lower(r.org)}
          <span class="text-faint">{dates(r.start, r.end)}</span>
        </li>
      ))}
    </ul>

    <h2 class="mt-8">Interests:</h2>
    <ul class="mt-2">
      <li class={item}>{lower(site.interests.join(", "))}</li>
    </ul>
    <p class="mt-6">{site.beyondCode}</p>

    <div id="contact" class="mt-6">
      <p>{site.contactNote}</p>
      <p class="mt-3">
        <a href={site.linkedin} target="_blank" rel="noreferrer" class={link}>linkedin</a>
        <span class="mx-2 text-faint">x</span>
        <a href={site.github} target="_blank" rel="noreferrer" class={link}>github</a>
      </p>
      <p class="mt-1 flex flex-wrap gap-x-4">
        <a href={`mailto:${site.email}`} class={link}>{site.email}</a>
        <a href={`mailto:${site.personalEmail}`} class={link}>{site.personalEmail}</a>
        <a href="/resume.pdf" target="_blank" rel="noreferrer" class={link}>resume</a>
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-[680px] px-5">
    <hr class="mt-16 border-line" />
  </div>

  <section id="work" class="mx-auto max-w-[680px] px-5 pt-16">
    <h2>Work:</h2>
    <p class="text-muted">{lower(site.workIntro)}</p>
  </section>

  <div class="mx-auto mt-8 grid max-w-[920px] gap-x-5 gap-y-10 px-5 sm:grid-cols-2 lg:grid-cols-3">
    {projects.map((p) => {
      const name = p.title.split(" (")[0];
      return (
        <article class="group">
          <div class="aspect-[4/3] overflow-hidden rounded-2xl bg-panel px-5 pt-6">
            {p.image ? (
              <div class="h-full overflow-hidden rounded-t-xl bg-well">
                {/* Grayscale to match the site; the colour comes back on hover. */}
                <img
                  src={p.image}
                  alt={p.imageAlt ?? `${name} screenshot`}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover object-left-top grayscale transition duration-300 group-hover:grayscale-0"
                />
              </div>
            ) : (
              <div class="flex h-full items-end rounded-t-xl bg-well p-4">
                <span class="text-2xl leading-tight text-line">{lower(name)}</span>
              </div>
            )}
          </div>
          <div class="mt-3 flex items-baseline justify-between gap-3">
            <h3 class="text-ink">{lower(name)}</h3>
            <span class="flex shrink-0 gap-3 text-xs">
              {p.repo && <a href={p.repo} target="_blank" rel="noreferrer" class={link}>code ↗</a>}
              {p.demo && <a href={p.demo} target="_blank" rel="noreferrer" class={link}>demo ↗</a>}
              {p.href && <a href={p.href} target="_blank" rel="noreferrer" class={link}>live ↗</a>}
            </span>
          </div>
          <p class="mt-1 line-clamp-4 text-xs leading-relaxed text-muted">{p.description}</p>
          {p.status && <p class="mt-1 text-xs text-faint">{lower(p.status)}</p>}
        </article>
      );
    })}
  </div>
</Layout>

<script>
  // Each location's current local time, refreshed often enough to turn over with the minute.
  const clocks = [...document.querySelectorAll<HTMLElement>("[data-time-zone]")];
  function tick() {
    const now = new Date();
    for (const clock of clocks) {
      const time = new Intl.DateTimeFormat("en-US", {
        hour: "numeric",
        minute: "2-digit",
        timeZone: clock.dataset.timeZone,
      }).format(now);
      clock.textContent = ` · ${time.toLowerCase()}`;
    }
  }
  tick();
  setInterval(tick, 15_000);
</script>
