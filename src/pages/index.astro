---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { projects } from "../data/projects";

const featured = projects.filter((p) => p.featured);
---

<Layout>
  <section class="mx-auto max-w-5xl px-6 pt-20 pb-16 sm:pt-28 sm:pb-24">
    <p class="mb-4 text-sm font-medium uppercase tracking-widest text-accent">{site.tagline}</p>
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">
      {site.heroHeadline}
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-400">
      {site.heroSubtext}
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="/projects"
        class="rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-[#0b0d12] transition-opacity hover:opacity-90"
      >
        View my work
      </a>
      <a
        href="/contact"
        class="rounded-lg border border-white/15 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/5"
      >
        Get in touch
      </a>
    </div>
  </section>

  <section class="border-t border-white/10 bg-white/[0.02]">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-accent">About</h2>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-300">
        {site.about}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16">
    <div class="mb-8 flex items-end justify-between">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-accent">Featured Projects</h2>
      <a href="/projects" class="text-sm font-medium text-slate-400 hover:text-white">View all &rarr;</a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2">
      {featured.map((project) => (
        <div class="rounded-xl border border-white/10 bg-white/[0.02] p-6 transition-colors hover:border-accent/40 hover:bg-white/[0.04]">
          <div class="flex items-start justify-between gap-4">
            <h3 class="text-lg font-semibold text-white">{project.title}</h3>
            {project.status && (
              <span class="shrink-0 text-xs font-medium text-slate-500">{project.status}</span>
            )}
          </div>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">{project.description}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="rounded-full border border-white/10 px-2.5 py-1 text-xs text-slate-400">{tag}</span>
            ))}
          </div>
          {(project.repo || project.demo || project.href) && (
            <div class="mt-5 flex gap-4 text-sm font-medium">
              {project.repo && (
                <a href={project.repo} target="_blank" rel="noreferrer" class="text-accent hover:underline">
                  Code &rarr;
                </a>
              )}
              {project.demo && (
                <a href={project.demo} target="_blank" rel="noreferrer" class="text-accent hover:underline">
                  Watch Demo &rarr;
                </a>
              )}
              {project.href && (
                <a href={project.href} target="_blank" rel="noreferrer" class="text-accent hover:underline">
                  Live &rarr;
                </a>
              )}
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-white/10 bg-white/[0.02]">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-accent">Skills</h2>
      <div class="mt-6 space-y-5">
        {Object.entries(site.skills).map(([category, items]) => (
          <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-4">
            <span class="w-56 shrink-0 text-sm font-medium text-slate-400">{category}</span>
            <div class="flex flex-wrap gap-2">
              {items.map((item) => (
                <span class="rounded-full border border-white/10 px-2.5 py-1 text-xs text-slate-300">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-accent">Beyond the Code</h2>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-300">
      {site.beyondCode}
    </p>
    <div class="mt-5 flex flex-wrap gap-2">
      {site.interests.map((interest) => (
        <span class="rounded-full border border-white/10 px-3 py-1.5 text-sm text-slate-300">{interest}</span>
      ))}
    </div>
  </section>
</Layout>
