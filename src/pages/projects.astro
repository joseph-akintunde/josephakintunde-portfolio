---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects";
---

<Layout title="Projects" description="A selection of projects I've built.">
  <section class="mx-auto max-w-5xl px-6 py-20">
    <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Projects</h1>
    <p class="mt-4 max-w-2xl text-slate-400">A selection of things I've built, broken, and fixed again.</p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {projects.map((project) => (
        <div class="rounded-xl border border-white/10 bg-white/[0.02] p-6">
          <div class="flex items-start justify-between gap-4">
            <h2 class="text-lg font-semibold text-white">{project.title}</h2>
            {project.status && (
              <span class="shrink-0 text-xs font-medium text-slate-500">{project.status}</span>
            )}
          </div>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">{project.description}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="rounded-full border border-white/10 px-2.5 py-1 text-xs text-slate-400">{tag}</span>
            ))}
          </div>
          <div class="mt-5 flex gap-4 text-sm font-medium">
            {project.repo && (
              <a href={project.repo} target="_blank" rel="noreferrer" class="text-accent hover:underline">
                Code &rarr;
              </a>
            )}
            {project.demo && (
              <a href={project.demo} target="_blank" rel="noreferrer" class="text-accent hover:underline">
                Watch Demo &rarr;
              </a>
            )}
            {project.href && (
              <a href={project.href} target="_blank" rel="noreferrer" class="text-accent hover:underline">
                Live &rarr;
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
